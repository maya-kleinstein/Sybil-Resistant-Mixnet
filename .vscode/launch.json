{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
    {
        "type": "lldb",
        "request": "attach",
        "name": "Attach",
        "program": "${workspaceFolder}/<program>"
    },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in library 'bbs'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=bbs"
                ],
                "filter": {
                    "name": "bbs",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug integration test 'bbs'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--test=bbs",
                    "--package=bbs"
                ],
                "filter": {
                    "name": "bbs",
                    "kind": "test"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}